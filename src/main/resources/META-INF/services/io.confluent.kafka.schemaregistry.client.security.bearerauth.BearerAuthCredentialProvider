# Confluent built-in providers (kafka-schema-registry-client 8.2.x).
# Listed here so the shadow jar (-all) exposes them via ServiceLoader even when the Confluent
# jar's own service file is not present. Thin jar users see these from both this file and
# Confluent's; BearerAuthCredentialProviderFactory returns the first alias match, so duplicates
# are harmless.
io.confluent.kafka.schemaregistry.client.security.bearerauth.StaticTokenCredentialProvider
io.confluent.kafka.schemaregistry.client.security.bearerauth.oauth.OauthCredentialProvider
io.confluent.kafka.schemaregistry.client.security.bearerauth.oauth.SaslOauthCredentialProvider
io.confluent.kafka.schemaregistry.client.security.bearerauth.CustomBearerAuthCredentialProvider

# Providers from this library
io.spoud.oauth.KeycloakFederatedRegistryBearerAuthCredentialProvider
io.spoud.oauth.JwtAssertionBearerAuthCredentialProvider
